@using System.Text.Json
@using ChordLibrary.Core
@using ChordLibrary.Core.Supabase
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IAppPlatform Platform
@inject AppSession Session
@inject AppBackNavigation BackNavigation

<div id="library-root" inert="@(accountOpen || preview is not null || busy)">@((MarkupString)libraryHtml)</div>
@if (!string.IsNullOrEmpty(startError))
{
    <div class="native-overlay"><section class="native-dialog" role="alert"><h2>Could not open your library</h2><p>@startError</p><p>Your saved files have been kept. Close and reopen the app after resolving the storage issue.</p></section></div>
}
@if (accountOpen)
{
    <div class="native-overlay"><section class="native-dialog @(busy ? "native-busy" : "")" role="dialog" aria-modal="true" aria-labelledby="account-title">
        <h2 id="account-title">Account & sync</h2>
        @if (Session.SignedIn)
        {
            <p>Signed in as <strong>@Session.Email</strong></p>
            <p>Your account library is saved on this device and synchronized across your devices.</p>
            <div class="native-actions"><button class="btn btn-primary" @onclick="ManualSync">Sync now</button><button class="btn btn-danger" @onclick="SignOut">Sign out</button></div>
            <small>Sign out returns to the separate local library. Account data stays on this device for your next sign-in.</small>
        }
        else if (Session.Options is not null)
        {
            <p>Sign in with Google to sync songs and setlists across your devices. Your local and account libraries are kept separate.</p>
            @if (Session.HasAccountLibrary) { <p class="native-status">Your session expired. This device still has your account library. Sign in again to sync.</p><button class="btn btn-secondary" @onclick="SignOut">Return to local library</button> }
            <div class="native-actions"><button class="btn btn-primary" disabled="@(!Platform.IsNative)" @onclick="GoogleSignIn">Continue with Google</button></div>
            @if (!Platform.IsNative) { <small>Google sign-in is available in the Windows and Android apps.</small> }
        }
        else { <p>Account sign-in is unavailable in this build. You can continue using your local library.</p> }
        @if (!string.IsNullOrEmpty(message)) { <p role="status" class="native-status">@message</p> }
        @if (authWait is not null) { <button class="btn btn-secondary cancel-auth" style="pointer-events:auto" @onclick="() => authWait?.Cancel()">Cancel sign-in</button> }
        <div class="native-actions"><button class="btn btn-secondary" @onclick="CloseAccount">Close</button></div>
    </section></div>
}
@if (preview is not null)
{
    <div class="native-overlay"><section class="native-dialog @(busy ? "native-busy" : "")" role="dialog" aria-modal="true" aria-labelledby="import-title">
        <h2 id="import-title">Import your library</h2>
        <p>Import into <strong>@(Session.Email ?? "the local library")</strong>.</p>
        <dl><dt>Songs</dt><dd>@preview.SongsAdded new · @preview.SongsUpdated updated</dd><dt>Setlists / playlists</dt><dd>@preview.SetlistsAdded new · @preview.SetlistsUpdated updated</dd></dl>
        <p>Existing records are replaced only when the backup has a newer update time. Song IDs and setlist order are preserved.</p>
        @foreach (var warning in preview.Warnings) { <p class="native-status">@warning</p> }
        @if (!string.IsNullOrEmpty(importError)) { <p class="error" role="alert">@importError</p> }
        <div class="native-actions"><button class="btn btn-secondary" @onclick="CancelImport">Cancel</button><button class="btn btn-primary" @onclick="CommitImport">Import</button></div>
    </section></div>
}
@code {
    private string libraryHtml = "", startError = "", message = "", importError = "";
    private string pendingJson = "";
    private bool accountOpen, busy, ready, cloudError;
    private CancellationTokenSource? authWait;
    private ImportPreview? preview;
    private string? importProfile;
    private LocalLibraryStore? importStore;
    private DotNetObjectReference<LibraryShell>? reference;
    private IDisposable? backRegistration;
    private readonly CancellationTokenSource lifetime = new();
    private Task? syncLoop;
    private readonly SemaphoreSlim operations = new(1,1);
    protected override void OnInitialized()
    {
        backRegistration = BackNavigation.Register(HandleBackAsync);
        using var stream = typeof(LibraryShell).Assembly.GetManifestResourceStream("ChordLibrary.Shared.Assets.library.html")!;
        using var reader = new StreamReader(stream); libraryHtml = reader.ReadToEnd();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            reference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("NativeBridge.configure", new { native = Platform.IsNative, qrImport = Platform.SupportsQrImport });
            await JS.InvokeVoidAsync("NativeBridge.initialize", reference);
            await JS.InvokeVoidAsync("libraryLoader.load");
            ready = true;
            await UpdateAccount();
            syncLoop = RunSyncLoop();
        }
        catch (Exception ex) { startError = ex.Message; await InvokeAsync(StateHasChanged); }
    }
    [JSInvokable] public async Task<Dictionary<string,string>> Initialize() { await Session.InitializeAsync(); return await Session.ReadInitialAsync(); }
    [JSInvokable] public Task SaveStorage(Dictionary<string,string> snapshot) => Session.SaveAsync(snapshot);
    [JSInvokable] public Task ExportFile(string filename, string json) => Platform.ExportAsync(filename,json);
    [JSInvokable] public Task<string?> PickSongFile() => Platform.PickJsonAsync();
    [JSInvokable] public Task<string?> ScanQr() => Platform.ReadQrAsync(true);
    [JSInvokable] public Task<string?> PickQrImage() => Platform.ReadQrAsync(false);
    [JSInvokable] public async Task PickImport() { var json = await Platform.PickJsonAsync(); if (json is not null) await PreviewImport(json); }
    [JSInvokable] public async Task PreviewImport(string json)
    {
        preview = await Session.Store.PreviewImportAsync(Session.ProfileId, json); pendingJson = json; importProfile = Session.ProfileId; importStore = Session.Store; importError = "";
        await InvokeAsync(StateHasChanged);
    }
    [JSInvokable] public async Task OpenAccount()
    {
        accountOpen = true; message = "";
        await InvokeAsync(StateHasChanged);
    }
    private void CloseAccount() { accountOpen = false; }
    private void CancelImport() { preview = null; pendingJson = ""; importError = ""; }
    private async Task<bool> HandleBackAsync()
    {
        var handled = true;
        await InvokeAsync(async () =>
        {
            if (authWait is not null) { authWait.Cancel(); return; }
            if (busy || !ready) return;
            if (preview is not null) { CancelImport(); StateHasChanged(); return; }
            if (accountOpen) { CloseAccount(); StateHasChanged(); return; }
            handled = await JS.InvokeAsync<bool>("NativeBridge.handleBack");
        });
        return handled;
    }
    private async Task Run(Func<Task> action)
    {
        if (busy) return; busy = true; message = "";
        await operations.WaitAsync();
        try { await JS.InvokeVoidAsync("NativeBridge.flush"); await action(); }
        catch (OperationCanceledException) { message = "Sign-in cancelled."; }
        catch (Exception ex) { cloudError = true; message = ex.Message; await JS.InvokeVoidAsync("NativeBridge.showToast", message, "error"); }
        finally { busy = false; operations.Release(); await UpdateAccount(); }
    }
    private async Task Refresh(bool reset = false)
    {
        await JS.InvokeVoidAsync("NativeBridge.flush");
        await Session.DeliverSnapshotAsync(snapshot => JS.InvokeVoidAsync("NativeBridge.replaceSnapshot", snapshot, reset).AsTask(), onlyIfChanged: !reset);
    }
    private Task GoogleSignIn() => Run(async () => {
        if (!await JS.InvokeAsync<bool>("NativeBridge.canSwitchAccount")) return;
        var uri = await Session.Auth!.BeginGoogleSignInAsync(new Uri(Platform.OAuthRedirectUri));
        authWait = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token); await InvokeAsync(StateHasChanged);
        try { var callback = await Platform.AuthenticateAsync(uri,authWait.Token); await Session.Auth.CompleteGoogleSignInAsync(callback); } finally { authWait.Dispose(); authWait = null; }
        Session.SelectAccount(); await Refresh(true); await SyncInternal();
    });
    private Task SignOut() => Run(async () => {
        if (!await JS.InvokeAsync<bool>("NativeBridge.canSwitchAccount")) return;
        var revoked = await Session.Auth!.SignOutAsync(); Session.SelectAccount(); await Refresh(true);
        message = revoked ? "Signed out. Your local library is open." : "Signed out on this device. The server could not be reached to revoke the session.";
    });
    private async Task CommitImport()
    {
        if (busy) return; busy = true;
        await operations.WaitAsync();
        try {
            await JS.InvokeVoidAsync("NativeBridge.flush");
            if (importProfile != Session.ProfileId || !ReferenceEquals(importStore, Session.Store)) throw new InvalidOperationException("The account changed. Select the backup again for this account.");
            await Session.Store.ImportAsync(Session.ProfileId,pendingJson); await Refresh(); CancelImport();
            await JS.InvokeVoidAsync("NativeBridge.showToast", "Library imported and saved on this device.", "success");
        } catch(Exception ex) { importError = ex.Message; } finally { busy = false; operations.Release(); }
    }
    private Task ManualSync() => Run(SyncInternal);
    private async Task SyncInternal()
    {
        if (!Session.SignedIn) return;
        await UpdateAccount("syncing");
        var result = await Session.SyncAsync(lifetime.Token); cloudError = result.Remaining > 0;
        if (await JS.InvokeAsync<bool>("NativeBridge.canRefresh")) await Refresh();
        message = result.Remaining == 0 ? "Library is up to date." : "Changes are saved on this device. Sync will retry automatically.";
    }
    private Task UpdateAccount(string? status = null) => ready ? JS.InvokeVoidAsync("NativeBridge.setAccount", new { signedIn = Session.HasAccountLibrary, email = Session.Email, displayName = Session.DisplayName, avatarUrl = Session.AvatarUrl, status = status ?? ((cloudError || (Session.HasAccountLibrary && !Session.SignedIn)) ? "error" : Session.SignedIn ? "idle" : "offline"), message }).AsTask() : Task.CompletedTask;
    private async Task RunSyncLoop()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(25));
        try {
            while (await timer.WaitForNextTickAsync(lifetime.Token)) await InvokeAsync(async () => {
                if (!Session.SignedIn || busy || preview is not null || !await JS.InvokeAsync<bool>("NativeBridge.canRefresh")) return;
                if (!await operations.WaitAsync(0)) return;
                try { await JS.InvokeVoidAsync("NativeBridge.flush"); await SyncInternal(); await UpdateAccount(); }
                catch (Exception) { message = "Cloud sync is unavailable. Changes remain saved on this device and will retry automatically."; await UpdateAccount("error"); }
                finally { operations.Release(); }
            });
        } catch (OperationCanceledException) { }
    }
    public async ValueTask DisposeAsync()
    {
        backRegistration?.Dispose();
        lifetime.Cancel();
        if (syncLoop is not null) { try { await syncLoop; } catch (JSDisconnectedException) { } }
        reference?.Dispose(); lifetime.Dispose();
    }
}
